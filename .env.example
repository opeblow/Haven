# Haven Environment Variables
# Copy to .env and fill in your values

# === AWS ===
AWS_REGION=us-east-1
HAVEN_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250514-v1:0
HAVEN_BEDROCK_ROUTING_MODEL_ID=amazon.nova-micro-v1:0

# === DynamoDB ===
HAVEN_DONATIONS_TABLE=haven-donations
HAVEN_VOLUNTEERS_TABLE=haven-volunteers
HAVEN_RECIPIENTS_TABLE=haven-recipients
HAVEN_SHIFTS_TABLE=haven-shifts
HAVEN_EVENTS_TABLE=haven-events
HAVEN_AUDIT_TABLE=haven-audit

# === S3 ===
HAVEN_DOCUMENTS_BUCKET=haven-documents

# === Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === Langfuse ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === API ===
HAVEN_API_HOST=0.0.0.0
HAVEN_API_PORT=8000
HAVEN_CORS_ORIGINS=["http://localhost:3000"]

# === DynamoDB Local (for development) ===
# Set to http://localhost:8000 to use local DynamoDB
HAVEN_DYNAMODB_ENDPOINT_URL=

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000

# === Escalation ===
HAVEN_ESCALATION_SLACK_WEBHOOK=
HAVEN_ESCALATION_SMS_NUMBERS=[]
